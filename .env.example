POSTGRES_DB=guess_country
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root

OPENAI_API_KEY=sk-...
DATABASE_URL=postgresql+asyncpg://postgres:root@db:5432/guess_country
QUIZ_MODEL=gpt-4o-mini
# Generate once (python -c 'import secrets; print(secrets.token_urlsafe(48))'),
# keep private and persistent: changing it invalidates existing signed sessions.
SECRET_KEY=
# Development browser origins only; production must set its exact HTTPS origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# One process/replica per PostgreSQL database; other values fail startup.
WEB_CONCURRENCY=1
# Comma-separated actual proxy peer CIDRs (e.g. 127.0.0.1/32 for a local proxy).
# Empty trusts no proxy. Never use a broad client range or an untrusted network.
QUESTION_RATE_LIMIT_TRUSTED_PROXIES=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Opt-in Remember me idle lifetime; authenticated requests renew this window.
REMEMBER_ME_EXPIRE_DAYS=90
QDRANT_HOST=qdrant
QDRANT_PORT=6333
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_SIZE=1536
EMAIL_USERNAME=your_email@example.com
NOREPLY_EMAIL=noreply@example.com
EMAIL_PASSWORD=your_email_password
GOOGLE_CLIENT_ID=your_google_client_id

VITE_API_URL=http://localhost:8080
VITE_RYBBIT_SCRIPT_URL=https://tafeen.me/rybbit/api/script.js
VITE_RYBBIT_SITE_ID=YOUR_SITE_ID
VITE_GOOGLE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# Friend duels: admission can be disabled without terminating existing matches.
FRIEND_MATCHES_ENABLED=true
FRIEND_ACTIVE_ROOM_LIMIT=500
FRIEND_AI_BACKLOG_LIMIT=100
FRIEND_AI_WORKERS=2
# HTTPS behind a proxy: set true for access, guest and friend cookies.
# Production Compose forces true; forwarding headers are not HTTPS detection.
# Leave unset for automatic HTTPS detection only when running TLS directly.
# FRIEND_COOKIE_SECURE=true
GEMINI_API_KEY=
LOCAL_QUESTION_MODEL=gemini-2.5-flash-lite
